# ============================================================
# MediSphere Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=medisphere

# JWT — MUST be a strong random secret in production (min 32 chars)
# Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Spring profile: dev | prod
SPRING_PROFILES_ACTIVE=dev

# Logging level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# FHIR integration mode: mock | live
# mock = MockFHIRClient (no external server required, default for development)
# live = LiveFHIRClient (requires FHIR_BASE_URL, FHIR_CLIENT_ID, FHIR_CLIENT_SECRET)
FHIR_MODE=mock
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# AI Prediction mode: stub | ml | tff
# stub = StubAIPredictionService (deterministic, no external AI, default for development)
# ml   = TFFAIPredictionService  (requires ML_SERVICE_URL and ML_INTERNAL_TOKEN)
# tff  = alias for ml (backwards compatible)
AI_PREDICTION_MODE=stub
TFF_ENDPOINT=

# ── ML Service (FastAPI) ──────────────────────────────────────────────────
# Required when AI_PREDICTION_MODE=ml
# ML_SERVICE_URL: base URL of the FastAPI ML inference service
# ML_INTERNAL_TOKEN: shared secret sent as X-Internal-Token header
#   Generate with: openssl rand -hex 32
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_TOKEN=dev-token

# AI Care Plan mode: stub | tff
AI_CAREPLAN_MODE=stub

# Federated Learning mode: stub | live
# stub = StubFederatedOrchestrator (in-memory, deterministic, default for development)
# live = LiveFederatedOrchestrator (production federated infrastructure)
FEDERATED_MODE=stub

# ── Phase 5: Kafka ──────────────────────────────────────────────────────
# Kafka broker address (KRaft mode — no Zookeeper required)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Phase 5: Wearable offline detection ────────────────────────────────
# Minutes without a vital reading before a device is marked offline
WEARABLE_OFFLINE_THRESHOLD=30

# ── Phase 5: Anomaly detection thresholds ──────────────────────────────
ANOMALY_SPO2_LOW_THRESHOLD=94.0
ANOMALY_BP_SYSTOLIC_THRESHOLD=140
ANOMALY_BP_DIASTOLIC_THRESHOLD=90
# Rolling window size for HR percentile baseline (number of readings)
ANOMALY_HR_HISTORY_WINDOW=50
# Minimum readings required before HR_SPIKE_P95 can fire
ANOMALY_HR_MIN_SAMPLES=5

# ── Phase 5: Wearable simulator (dev only) ──────────────────────────────
# Set to false to disable the simulator even in dev profile
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=5
