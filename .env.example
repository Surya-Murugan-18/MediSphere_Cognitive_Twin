# =============================================================================
# MediSphere Cognitive Twin — Root Environment Variables
# Used by: docker-compose.yml
#
# Copy this file to .env and fill in real values.
#   cp .env.example .env
#
# NEVER commit .env to source control.
# =============================================================================

# ── JWT ────────────────────────────────────────────────────────────────────────
# REQUIRED: Must be a strong random secret (minimum 32 characters).
# Generate a suitable value with:
#   openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_MINIMUM_32_CHARS

# Token expiry in seconds (defaults shown)
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=2592000

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# In Docker Compose the frontend Nginx is on port 3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Spring Profile ────────────────────────────────────────────────────────────
# dev  — enables DataSeeder (provider + patient seed data) + wearable simulator
# prod — disables seeder and simulator; all data must come from real sources
SPRING_PROFILES_ACTIVE=dev

# ── FHIR ───────────────────────────────────────────────────────────────────────
# mock — MockFHIRClient (default for development, no external server required)
# live — LiveFHIRClient (requires FHIR_BASE_URL, FHIR_CLIENT_ID, FHIR_CLIENT_SECRET)
FHIR_MODE=mock
FHIR_BASE_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=

# ── AI Prediction ─────────────────────────────────────────────────────────────
# stub — StubAIPredictionService (deterministic, no external AI required)
# tff  — TFFAIPredictionService (requires TFF_ENDPOINT)
AI_PREDICTION_MODE=stub
AI_CAREPLAN_MODE=stub
TFF_ENDPOINT=

# ── Federated Learning ─────────────────────────────────────────────────────────
# stub — StubFederatedOrchestrator (deterministic in-memory)
# live — LiveFederatedOrchestrator (production federated infrastructure)
FEDERATED_MODE=stub

# ── Wearable Simulator (dev only) ─────────────────────────────────────────────
# Produces vitals.raw Kafka messages every SIMULATOR_INTERVAL seconds.
# Automatically disabled when SPRING_PROFILES_ACTIVE != dev.
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=5

# ── Anomaly Detection Thresholds ──────────────────────────────────────────────
ANOMALY_SPO2_LOW_THRESHOLD=94.0
ANOMALY_BP_SYSTOLIC_THRESHOLD=140
ANOMALY_BP_DIASTOLIC_THRESHOLD=90
ANOMALY_HR_HISTORY_WINDOW=50
ANOMALY_HR_MIN_SAMPLES=5
WEARABLE_OFFLINE_THRESHOLD=30

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
